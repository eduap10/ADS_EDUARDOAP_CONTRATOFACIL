{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ContratoFacil: compilar",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "RemoteSigned",
                "-File",
                "${workspaceFolder}/scripts/build.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "ContratoFacil: executar Tomcat",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "RemoteSigned",
                "-File",
                "${workspaceFolder}/scripts/tomcat.ps1"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "ContratoFacil: parar Tomcat",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "RemoteSigned",
                "-File",
                "${workspaceFolder}/scripts/tomcat.ps1",
                "-Stop"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
